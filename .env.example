# Server & Node Settings
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Frontend Applications URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4001/realtime/rooms

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aistudyhub?schema=public"

# Redis Cache & PubSub Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Session Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Dynamic AI Models Gateway
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# Telemetry & Monitoring
PROMETHEUS_METRICS_PORT=9090
